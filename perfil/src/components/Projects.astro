---
const projects = [
    {
        title: "VCOM — Video Communication",
        description:
            "Sistema de atendimento por vídeo desenvolvido para uso profissional, com gerenciamento de filas, chamadas, chat, gravações e monitoramento.",
        type: "PRIVADO · PROFISSIONAL",
        image: "/images/projects/vcom-cover.jpg",
        stack: ["FastAPI", "PostgreSQL", "Redis", "LiveKit"],
        href: "/projetos/vcom",
    },
    {
        title: "Cardápio",
        description:
            "Sistema web para gerenciamento de cardápio, produtos, categorias, usuários e imagens.",
        type: "PUBLIC · GITHUB",
        image: "/images/projects/cardapio-cover.jpg",
        stack: ["Next.js", "React", "TypeScript", "Turso"],
        href: "/projetos/cardapio",
    },
    {
        title: "Autoatendimento Maria Bonita",
        description:
            "Sistema de autoatendimento com fluxo de pedidos, pagamentos e painel administrativo.",
        type: "PUBLIC · GITHUB",
        image: "/images/projects/maria-bonita-cover.jpg",
        stack: ["Node.js", "Express", "PostgreSQL"],
        href: "/projetos/autoatendimento",
    },
];
---

<section id="projetos" class="projects">

    <div class="section-header">
        <span class="section-number">03</span>

        <div>
            <p class="section-eyebrow">Trabalho</p>
            <h2>Projetos</h2>
        </div>
    </div>

    <div class="projects-list">

        {projects.map((project, index) => (
            <a href={project.href} class="project-card">
                <div class="project-image">
                    <img src={project.image} alt={`Preview do projeto ${project.title}`} loading={index === 0 ? "eager" : "lazy"}/>

                    <span class="project-number">
                        {String(index + 1).padStart(2, "0")}
                    </span>
                </div>

                <div class="project-content">

                    <div class="project-top">
                        <span class="project-type">
                            {project.type}
                        </span>

                        <span class="project-arrow" aria-hidden="true">
                            ↗
                        </span>
                    </div>

                    <h3>{project.title}</h3>

                    <p>{project.description}</p>

                    <div class="project-stack">
                        {project.stack.map((technology) => (
                            <span>{technology}</span>
                        ))}
                    </div>

                </div>
            </a>
        ))}

    </div>

</section>