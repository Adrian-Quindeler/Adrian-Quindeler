---
const projects = [
    {
        title: "Sistema de chamada de vídeo",
        description:
            "Sistema de atendimento por vídeo desenvolvido para uso profissional, com gerenciamento de filas e chamadas, chat, gravações e monitoramento.",
        type: "PRIVADO · PROFISSIONAL",
        stack: ["FastAPI", "PostgreSQL", "Redis", "LiveKit"],
        href: "/projects/chamada-de-video",
    },
    {
        title: "Cardápio da Mamute BR 262",
        description:
            "Sistema web para gerenciamento de cardápio, produtos, categorias, usuários e imagens.",
        type: "PUBLIC · GITHUB",
        image: "/img/projects/cardapio-cover.jpg",
        stack: ["Next.js", "React", "TypeScript", "Turso"],
        href: "/projects/cardapio",
    },
    {
        title: "Autoatendimento Maria Bonita",
        description:
            "Sistema de autoatendimento com fluxo de pedidos, pagamentos e painel administrativo.",
        type: "PUBLIC · GITHUB",
        image: "/img/projects/autoatendimento-cover.jpg",
        stack: ["Node.js", "Express", "PostgreSQL"],
        href: "/projects/autoatendimento",
    },
    {
        title: "ERP corporativo",
        description:
            "Sistema interno com login, dashboard modular, menu lateral e ferramentas para pessoas, campanhas, analytics e logística.",
        type: "PRIVADO · PROFISSIONAL",
        stack: ["PHP", "MySQL", "Bootstrap", "jQuery"],
        href: "/projects/erp-corporativo",
    },
];
---

<section id="projetos" class="projects">

    <div class="section-header">
        <span class="section-number">03</span>

        <div>
            <h2>Projetos</h2>
        </div>
    </div>

    <div class="projects-list">

        {projects.map((project, index) => (
            <a href={project.href} class="project-card">
                {project.image && (
                    <div class="project-image">
                        <img src={project.image} alt={`Preview do projeto ${project.title}`} loading={index === 0 ? "eager" : "lazy"}/>

                        <span class="project-number">
                            {String(index + 1).padStart(2, "0")}
                        </span>
                    </div>
                )}

                <div class="project-content">

                    <div class="project-top">
                        <div class="project-heading-meta">
                            {!project.image && (
                                <span class="project-number project-number--inline">
                                    {String(index + 1).padStart(2, "0")}
                                </span>
                            )}

                            <span class="project-type">
                                {project.type}
                            </span>
                        </div>

                        <span class="project-arrow" aria-hidden="true">
                            ↗
                        </span>
                    </div>

                    <h3>{project.title}</h3>

                    <p>{project.description}</p>

                    <div class="project-stack">
                        {project.stack.map((technology) => (
                            <span>{technology}</span>
                        ))}
                    </div>

                </div>
            </a>
        ))}

    </div>

</section>