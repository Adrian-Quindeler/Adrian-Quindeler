---
import "../styles/header-hero.css";
---

<section id="inicio" class="hero">
	<div class="hero-container">
		<div class="hero-content">
			<p class="hero-eyebrow">Full Stack Developer</p>
			<h1>Adrian Jansen Quindeler</h1>

			<p class="hero-description">
				Desenvolvedor com experiência profissional no desenvolvimento e
				manutenção de sistemas web, atuando em backend, frontend, bancos
				de dados, APIs e integrações.
			</p>

			<div class="hero-stack">
				<span>TypeScript</span>
				<span>Node.js</span>
				<span>React</span>
				<span>Next.js</span>
				<span>Python</span>
				<span>FastAPI</span>
				<span>PHP</span>
				<span>PostgreSQL</span>
			</div>

			<div class="hero-actions">
				<a href="#projetos" class="btn btn-primary">
					Ver projetos
					<i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
				</a>

				<a href="/curriculo.pdf" class="btn btn-secondary" download>
					Baixar CV
					<i class="fa-solid fa-download" aria-hidden="true"></i>
				</a>
			</div>
		</div>

		<div class="hero-visual">
			<div class="hero-image">
				<img
					src="/images/hero.png"
					alt="Adrian Jansen Quindeler"
					width="420"
					height="520"
				/>

				<div class="hero-location">
					<i class="fa-solid fa-location-dot" aria-hidden="true"></i>
					<span>Vitória/ES - Brasil</span>
				</div>
			</div>
		</div>
	</div>
</section>
